[Unit]
Description=OmniSMS personal SMS forwarding service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omnisms
Group=omnisms
EnvironmentFile=/etc/omnisms/omnisms.env
ExecStart=/opt/omnisms/omnisms-server
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/omnisms
MemoryMax=192M
TasksMax=64

[Install]
WantedBy=multi-user.target
