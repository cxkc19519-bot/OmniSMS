# 只复制到 VPS 的 /etc/omnisms/omnisms.env，并填入真实值。
# 不要把真实配置提交到仓库，也不要把应用专用密码发到聊天中。
OMNISMS_LISTEN=127.0.0.1:8088
OMNISMS_DATABASE_PATH=/var/lib/omnisms/omnisms.sqlite3
OMNISMS_DEVICE_ID=replace-with-random-device-id
OMNISMS_DEVICE_SECRET=replace-with-keygen-output
OMNISMS_SMTP_HOST=smtp.gmail.com
OMNISMS_SMTP_PORT=587
OMNISMS_SMTP_USERNAME=your-account@example.com
OMNISMS_SMTP_APP_PASSWORD=replace-on-vps-only
OMNISMS_MAIL_FROM=your-account@example.com
OMNISMS_MAIL_TO=your-account@example.com
OMNISMS_TIMEZONE=Asia/Shanghai
OMNISMS_RETENTION=24h
OMNISMS_AUTH_MAX_SKEW=5m
OMNISMS_WORKER_INTERVAL=5s
OMNISMS_SMTP_TIMEOUT=20s
